# ConvoScale Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (Optional: defaults to embedded high-performance PostgreSQL/WAL engine)
# Set DATABASE_URL to connect to external PostgreSQL (e.g. postgres://postgres:password@localhost:5432/convoscale)
# DATABASE_URL=postgres://postgres:password@localhost:5432/convoscale
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000

# Redis Cache & Lock Configuration (Optional: defaults to high-speed in-memory LRU cache)
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Security & Authentication
JWT_SECRET=convoscale_super_secure_production_secret_key_2026_jwt
JWT_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANONYMOUS=120
RATE_LIMIT_MAX_AUTHENTICATED=600
RATE_LIMIT_GLOBAL_MAX=25000
