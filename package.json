  "description": "High-Performance Chat Backend & Database Engine handling 10,000+ Requests Per Minute",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/db/seed.js",
